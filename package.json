{
  "name": "pi-brain-wiki",
  "version": "0.1.0",
  "description": "A Pi package for persistent markdown wikis with source capture, generated metadata, linting, and LLM wiki-maintainer skills.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "wiki",
    "obsidian",
    "knowledge-base",
    "llm",
    "research",
    "pkm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/walker/pi-brain-wiki.git"
  },
  "homepage": "https://github.com/walker/pi-brain-wiki#readme",
  "bugs": {
    "url": "https://github.com/walker/pi-brain-wiki/issues"
  },
  "files": [
    "extensions",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "tsconfig.json"
  ],
  "scripts": {
    "check": "node --experimental-strip-types ./scripts/check.ts",
    "release:patch": "node --experimental-strip-types ./scripts/release.ts patch",
    "release:minor": "node --experimental-strip-types ./scripts/release.ts minor",
    "release:major": "node --experimental-strip-types ./scripts/release.ts major",
    "release:push": "git push origin main --follow-tags",
    "prepublishOnly": "npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/brain-wiki/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "dependencies": {
    "gray-matter": "^4.0.3"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
